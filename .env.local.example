# Database Connection String (Supabase > Settings > Database > Connection string > Transaction Pooler)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# App Configuration
NEXT_PUBLIC_APP_NAME=EBD - Sistema de Gestão
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development
